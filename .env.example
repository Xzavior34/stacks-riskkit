# Stacks RiskKit — environment configuration
#
# No secrets are required to run the demo. Stacks testnet account/token data
# is public and read-only; no API key is needed for the default Hiro API tier.

# Base URL for the Stacks API used to fetch testnet account/token data.
# Defaults to Hiro's public testnet API if unset.
VITE_STACKS_API_URL=https://api.testnet.hiro.so

# Stacks network name. Only "testnet" is supported in this prototype.
VITE_STACKS_NETWORK=testnet
